# Required (get a free key at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: what you sell. Used only to pick a relevant angle, never pitched in the icebreaker.
SENDER_OFFER=

# Optional tuning
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_TIMEOUT_MS=60000
# Free tier allows 15 requests/min per model. Raise it on a paid key, 0 = no limit.
GEMINI_RPM=14
INPUT_FILE=prospects.csv
OUTPUT_FILE=enriched_prospects.csv
CONCURRENCY=3
MAX_WORDS=45
FETCH_TIMEOUT_MS=12000
CACHE_FILE=data/cache.json
